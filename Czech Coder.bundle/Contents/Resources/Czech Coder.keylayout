  <actions>
    <action id="deadAcute">
      <when state="none" next="acute"/>
    </action>
    <action id="deadCaron">
      <when state="none" next="caron"/>
    </action>
    <action id="deadRing">
      <when state="none" next="ring"/>
    </action>
    <action id="deadDia">
      <when state="none" next="dia"/>
    </action>
    <action id="a">
      <when state="none" output="a"/>
      <when state="acute" output="á"/>
      <when state="ring" output="å"/>
      <when state="dia" output="ä"/>
    </action>
    <action id="A">
      <when state="none" output="A"/>
      <when state="acute" output="Á"/>
      <when state="ring" output="Å"/>
      <when state="dia" output="Ä"/>
    </action>
    <action id="c">
